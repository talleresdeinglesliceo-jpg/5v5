-- // DETECCIÓN DE ROLES //
local function GetPlayerRole(player)
    local hasKnife, hasGun = false, false

    local function checkContainer(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "cuchillo") or string.find(name, "blade") or string.find(name, "dagger") or string.find(name, "sword") then
                    hasKnife = true
                elseif string.find(name, "gun") or string.find(name, "revolver") or string.find(name, "pistola") or string.find(name, "sheriff") or string.find(name, "deagle") then
                    hasGun = true
                end
            end
        end
    end

    checkContainer(player.Character)
    checkContainer(player:FindFirstChild("Backpack"))

    if hasKnife then
        return "KNIFE", Color3.fromRGB(255, 59, 48)
    elseif hasGun then
        return "GUN", Color3.fromRGB(0, 122, 255)
    else
        return "INOCENTE", Color3.fromRGB(52, 199, 89)
    end
end

-- // OBJETIVO EN FOV //
local function GetClosestTargetInFOV()
    local closestTarget = nil
    local shortestDistance = Config.FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetPart = player.Character:FindFirstChild(Config.TargetPart) or player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

            if targetPart and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist <= shortestDistance then
                        shortestDistance = dist
                        closestTarget = targetPart
                    end
                end
            end
        end
    end
    return closestTarget
end

-- // ESP //
local ESPObjects = {}

local function RemoveESP(player)
    if ESPObjects[player] then
        if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
        if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
        ESPObjects[player] = nil
    end
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.ESPEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local roleText, roleColor = "JUGADOR", Color3.fromRGB(255, 255, 255)
                if Config.ESPShowRoles then
                    roleText, roleColor = GetPlayerRole(player)
                end

                if not ESPObjects[player] then
                    ESPObjects[player] = {}

                    local hl = Instance.new("Highlight")
                    hl.Name = "FamilyESP_HL"
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = ESPFolder
                    ESPObjects[player].Highlight = hl

                    local bb = Instance.new("BillboardGui")
                    bb.Name = "FamilyESP_BB"
                    bb.Size = UDim2.new(0, 120, 0, 40)
                    bb.StudsOffset = Vector3.new(0, 3.2, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = ESPFolder

                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 13
                    txt.TextStrokeTransparency = 0.3
                    txt.Parent = bb

                    ESPObjects[player].Billboard = bb
                    ESPObjects[player].Label = txt
                end

                local data = ESPObjects[player]
                data.Highlight.Adornee = player.Character
                data.Highlight.FillColor = roleColor
                data.Highlight.OutlineColor = roleColor

                data.Billboard.Adornee = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                data.Label.TextColor3 = roleColor
                data.Label.Text = Config.ESPShowRoles and string.format("%s\n[%s]", player.Name, roleText) or player.Name
            else
                RemoveESP(player)
            end
        end
    end
end

Players.PlayerRemoving:Connect(RemoveESP)

