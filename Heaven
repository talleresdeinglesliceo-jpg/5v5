local OriginalSky = Lighting:FindFirstChildOfClass("Sky")
local CustomSky = Instance.new("Sky")
CustomSky.Name = "FamilyHud_CustomSky"

local function ApplySkybox(preset)
    Config.SelectedSkybox = preset.Name
    if preset.Name == "Default" then
        CustomSky.Parent = nil
        if OriginalSky then OriginalSky.Parent = Lighting end
        return
    end

    if OriginalSky then OriginalSky.Parent = nil end
    CustomSky.Parent = Lighting
    CustomSky.CelestialBodiesShown = preset.Sun

    if preset.AssetId ~= "" then
        CustomSky.SkyboxBk = preset.AssetId
        CustomSky.SkyboxDn = preset.AssetId
        CustomSky.SkyboxFt = preset.AssetId
        CustomSky.SkyboxLf = preset.AssetId
        CustomSky.SkyboxRt = preset.AssetId
        CustomSky.SkyboxUp = preset.AssetId
    end

    Lighting.Ambient = preset.Ambient
    Lighting.OutdoorAmbient = preset.Outdoor
end

